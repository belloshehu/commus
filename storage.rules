rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Non-public by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Incident Evidence Storage
    match /evidence/{communityId}/{incidentId}/{mediaId} {
      // Access controlled via Authentication and community membership / authority roles
      allow read: if request.auth != null;

      // Only authenticated, non-anonymous users can upload evidence media
      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('audio/.*'));
    }
  }
}
